# Copy this file to .dev.vars for local Cloudflare development.
# Never commit .dev.vars or real secret values.

# Required server-side secret
OPENAI_API_KEY=

# OpenAI model routing
AI_DESIGNER_MODEL=gpt-5.6
AI_PLAYER_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT_DESIGNER=medium
OPENAI_REASONING_MODE_DESIGNER=standard
OPENAI_REASONING_EFFORT_PLAYER=low
OPENAI_REASONING_MODE_PLAYER=standard

# AI reliability and budget controls
AI_ENABLED=true
AI_MAX_REPAIR_ATTEMPTS=3
AI_REQUEST_TIMEOUT_MS=20000
AI_MAX_INPUT_CHARS=48000
AI_MAX_REQUESTS_PER_ROOM_PER_HOUR=20
AI_MAX_REQUESTS_PER_DAY=200
AI_MAX_ESTIMATED_INPUT_TOKENS_PER_DAY=250000

# Room and command limits
ROOM_MAX_CELL_BYTES=32768
ROOM_MAX_CELLS=2000
ROOM_MAX_CONNECTIONS=16
ROOM_COMMANDS_PER_MINUTE=120
ROOM_MAX_CHAT_MESSAGE_BYTES=8192

# Runtime defaults shared with the client build
RUNTIME_FUEL_PER_CELL=50000
RUNTIME_MAX_CALL_DEPTH=64
RUNTIME_MAX_COLLECTION_SIZE=2000
RUNTIME_MAX_TRIGGER_STEPS=500
RUNTIME_MAX_HEAP_OBJECTS=20000

# App configuration
PUBLIC_APP_ORIGIN=http://localhost:5173
DEMO_TEMPLATE_ID=shifting-vaults-v1
LOG_LEVEL=info

# CI/deployment secrets: configure in GitHub Actions, not in .dev.vars.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
