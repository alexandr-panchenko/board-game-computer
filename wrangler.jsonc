{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "board-game-computer",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomObject",
      },
      {
        "name": "AI_BUDGET",
        "class_name": "BudgetObject",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomObject"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["BudgetObject"],
    },
  ],
  "vars": {
    "AI_ENABLED": "true",
    "AI_DESIGNER_MODEL": "gpt-5.6",
    "AI_PLAYER_MODEL": "gpt-5.6-luna",
    "AI_MAX_REQUESTS_PER_DAY": "200",
    "AI_MAX_ESTIMATED_INPUT_TOKENS_PER_DAY": "250000",
    "AI_MAX_REQUESTS_PER_ROOM_PER_HOUR": "20",
    "AI_REQUEST_TIMEOUT_MS": "20000",
  },
  "observability": {
    "enabled": true,
  },
  "env": {
    "test": {
      "durable_objects": {
        "bindings": [
          {
            "name": "ROOMS",
            "class_name": "RoomObject",
          },
          {
            "name": "AI_BUDGET",
            "class_name": "BudgetObject",
          },
        ],
      },
      "vars": {
        "AI_ENABLED": "false",
        "AI_DESIGNER_MODEL": "gpt-5.6",
        "AI_PLAYER_MODEL": "gpt-5.6-luna",
        "AI_MAX_REQUESTS_PER_DAY": "200",
        "AI_MAX_ESTIMATED_INPUT_TOKENS_PER_DAY": "250000",
        "AI_MAX_REQUESTS_PER_ROOM_PER_HOUR": "20",
        "AI_REQUEST_TIMEOUT_MS": "20000",
      },
    },
  },
}
